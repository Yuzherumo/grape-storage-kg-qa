{
  "version": "1.0.0",
  "project": "鲜食葡萄采后贮藏知识图谱（农客松 2026 · 方向二 生命系统）",
  "owner": "kg-builder",
  "updated_at": "S1",
  "description": "图谱标签/谓词/合法性组合/双来源规则/枚举的唯一机器可读口径。validate_data.py 与 gen_cypher.py 均以此为准。",
  "labels": {
    "Variety": {
      "zh": "品种",
      "id_prefix": "品种英文蛇形，如 shine_muscat",
      "required_props": [
        "id",
        "label",
        "name"
      ],
      "optional_props": [
        "aliases",
        "species",
        "berry_color",
        "seedless",
        "maturity",
        "region",
        "source_ids",
        "note"
      ],
      "name_required": true
    },
    "Condition": {
      "zh": "储藏条件/环境风险",
      "id_prefix": "条件英文蛇形，如 cold_0",
      "required_props": [
        "id",
        "label",
        "name",
        "category"
      ],
      "optional_props": [
        "aliases",
        "value_min",
        "value_max",
        "unit",
        "stage",
        "source_ids",
        "note"
      ],
      "name_required": true
    },
    "QualityIndicator": {
      "zh": "品质指标",
      "id_prefix": "指标英文蛇形，如 decay_rate",
      "required_props": [
        "id",
        "label",
        "name",
        "direction"
      ],
      "optional_props": [
        "aliases",
        "unit",
        "stage",
        "method",
        "source_ids",
        "note"
      ],
      "name_required": true
    },
    "Disease": {
      "zh": "采后病害",
      "id_prefix": "病害英文蛇形，如 gray_mold",
      "required_props": [
        "id",
        "label",
        "name"
      ],
      "optional_props": [
        "aliases",
        "pathogen_latin",
        "symptom",
        "source_ids",
        "note"
      ],
      "name_required": true
    },
    "Source": {
      "zh": "来源",
      "id_prefix": "来源英文蛇形，如 gbt16862_2026",
      "required_props": [
        "id",
        "title",
        "type",
        "access"
      ],
      "optional_props": [
        "authors",
        "year",
        "venue",
        "doi_url",
        "note"
      ],
      "name_required": false,
      "note": "Source 节点由 data/sources.csv 生成，不写入 data/entities.csv（entities.csv 只承载 4 类业务标签）。"
    }
  },
  "entity_targets": {
    "Variety": 8,
    "Condition": 30,
    "QualityIndicator": 13,
    "Disease": 7,
    "Source": "10~12"
  },
  "condition_categories": [
    "温度",
    "湿度",
    "气调",
    "化学",
    "物理",
    "包装",
    "采后操作",
    "环境风险"
  ],
  "indicator_directions": [
    "higher_better",
    "lower_better",
    "target"
  ],
  "stages": [
    "预冷",
    "贮藏",
    "出库"
  ],
  "predicates": {
    "REQUIRES": {
      "zh": "需要",
      "subject_type": "Variety",
      "object_type": "Condition",
      "properties": [
        "value",
        "value_min",
        "value_max",
        "unit",
        "stage",
        "reason"
      ],
      "group": "A"
    },
    "CONTRA_INDICATED_FOR": {
      "zh": "禁用于",
      "subject_type": "Condition",
      "object_type": "Variety",
      "properties": [
        "severity",
        "reason"
      ],
      "group": "B",
      "requires_two_sources": true
    },
    "AFFECTS": {
      "zh": "影响",
      "subject_type": "Condition",
      "object_type": "QualityIndicator",
      "properties": [
        "effect",
        "level",
        "reason"
      ],
      "group": "C",
      "effect_enum": [
        "increase",
        "decrease",
        "none"
      ]
    },
    "SUSCEPTIBLE_TO": {
      "zh": "易感",
      "subject_type": "Variety",
      "object_type": "Disease",
      "properties": [
        "severity",
        "reason"
      ],
      "group": "D"
    },
    "PREVENTED_BY": {
      "zh": "可通过……预防",
      "subject_type": "Disease",
      "object_type": "Condition",
      "properties": [
        "efficacy",
        "reason"
      ],
      "group": "E"
    },
    "INDUCED_BY": {
      "zh": "由……诱发",
      "subject_type": "Disease",
      "object_type": "Condition",
      "properties": [
        "reason"
      ],
      "group": "F"
    },
    "ALTERNATIVE_TO": {
      "zh": "可替代",
      "subject_type": "Condition",
      "object_type": "Condition",
      "properties": [
        "reason"
      ],
      "group": "G",
      "requires_two_sources": true
    },
    "INDICATES": {
      "zh": "指示",
      "subject_type": "QualityIndicator",
      "object_type": "Disease",
      "properties": [
        "reason"
      ],
      "group": "H",
      "requires_two_sources": true
    },
    "HAS_INDICATOR_VALUE": {
      "zh": "指标参考值",
      "subject_type": "Variety",
      "object_type": "QualityIndicator",
      "properties": [
        "value",
        "value_min",
        "value_max",
        "unit",
        "stage",
        "reason"
      ],
      "group": "I"
    }
  },
  "predicate_type_combos": {
    "REQUIRES": {
      "subject_type": "Variety",
      "object_type": "Condition"
    },
    "CONTRA_INDICATED_FOR": {
      "subject_type": "Condition",
      "object_type": "Variety"
    },
    "AFFECTS": {
      "subject_type": "Condition",
      "object_type": "QualityIndicator"
    },
    "SUSCEPTIBLE_TO": {
      "subject_type": "Variety",
      "object_type": "Disease"
    },
    "PREVENTED_BY": {
      "subject_type": "Disease",
      "object_type": "Condition"
    },
    "INDUCED_BY": {
      "subject_type": "Disease",
      "object_type": "Condition"
    },
    "ALTERNATIVE_TO": {
      "subject_type": "Condition",
      "object_type": "Condition"
    },
    "INDICATES": {
      "subject_type": "QualityIndicator",
      "object_type": "Disease"
    },
    "HAS_INDICATOR_VALUE": {
      "subject_type": "Variety",
      "object_type": "QualityIndicator"
    }
  },
  "source_rules": {
    "multi_source_predicates": [
      "CONTRA_INDICATED_FOR",
      "ALTERNATIVE_TO",
      "INDICATES"
    ],
    "multi_source_groups": [
      "B",
      "G",
      "H"
    ],
    "min_sources": 2,
    "single_source_note_keyword": "单来源，建议后续实验验证",
    "check": "B/G/H 每条必须 source_ids>=2；确只有 1 篇支撑时 note 必须包含 single_source_note_keyword。"
  },
  "status": {
    "enum": [
      "verified",
      "anchor"
    ],
    "weights": {
      "verified": 1.0,
      "anchor": 0.6
    },
    "default": "anchor",
    "anchor_rule": "未拿到原文直接引文/页码时 status=anchor，locator 必填，note 必须写明待核验点。"
  },
  "confidence": {
    "type": "float",
    "min": 0.0,
    "max": 1.0,
    "default": 0.6
  },
  "effect_enum": [
    "increase",
    "decrease",
    "none"
  ],
  "severity_enum": [
    "高",
    "中",
    "低"
  ],
  "efficacy_enum": [
    "高",
    "中",
    "低"
  ],
  "source_types": [
    "国标",
    "综述",
    "论文",
    "行业资料"
  ],
  "access_enum": [
    "public",
    "paywalled"
  ],
  "csv_columns": {
    "entities": [
      "id",
      "label",
      "name",
      "aliases",
      "category",
      "value_min",
      "value_max",
      "unit",
      "stage",
      "direction",
      "method",
      "species",
      "berry_color",
      "seedless",
      "maturity",
      "region",
      "pathogen_latin",
      "symptom",
      "source_ids",
      "note"
    ],
    "triples": [
      "sid",
      "subject",
      "subject_type",
      "predicate",
      "object",
      "object_type",
      "value",
      "value_min",
      "value_max",
      "unit",
      "stage",
      "effect",
      "level",
      "severity",
      "efficacy",
      "reason",
      "source_ids",
      "locator",
      "quote",
      "status",
      "confidence",
      "note"
    ],
    "sources": [
      "id",
      "title",
      "authors",
      "year",
      "venue",
      "type",
      "doi_url",
      "access",
      "note"
    ]
  },
  "groups": {
    "A": {
      "predicate": "REQUIRES",
      "target": 26,
      "zh": "品种-储藏条件"
    },
    "B": {
      "predicate": "CONTRA_INDICATED_FOR",
      "target": 3,
      "zh": "禁忌"
    },
    "C": {
      "predicate": "AFFECTS",
      "target": 19,
      "zh": "条件-指标影响"
    },
    "D": {
      "predicate": "SUSCEPTIBLE_TO",
      "target": 8,
      "zh": "品种-病害易感"
    },
    "E": {
      "predicate": "PREVENTED_BY",
      "target": 22,
      "zh": "病害-预防"
    },
    "F": {
      "predicate": "INDUCED_BY",
      "target": 7,
      "zh": "病害-诱因"
    },
    "G": {
      "predicate": "ALTERNATIVE_TO",
      "target": 3,
      "zh": "条件替代"
    },
    "H": {
      "predicate": "INDICATES",
      "target": 2,
      "zh": "指标-病害指示"
    },
    "I": {
      "predicate": "HAS_INDICATOR_VALUE",
      "target": 18,
      "zh": "品种-指标参考值"
    }
  },
  "groups_rebalance_note": "S2b 期按 Lead 指令两次调整：(1) C 18→16（删 2 条同类边：低温→果梗褐变、常温→失重），I 6→8（补夏黑/玫瑰香耐贮性，Q2 品种对比依赖），总数仍 68；(2) 再补 3 条 C 组 AFFECTS（臭氧→腐烂率、低温→硬度、气调O2→维生素C），消除 3 个孤立节点（臭氧处理/硬度/维生素C），总数 68→71，Lead 已接受『≥68』。最终分组：A14 B3 C19 D8 E8 F6 G3 H2 I8 = 71。",
  "triple_targets": {
    "target": 108,
    "floor": 50,
    "shine_muscat_min": 20,
    "note": "M8 国标条文入库后口径；原计划 68，现按实际条数维护"
  },
  "validation_checks": [
    "1 列完整性：entities/triples/sources 表头与 csv_columns 一致",
    "2 枚举合法：label/predicate/status/type/access/direction/effect/severity/efficacy/category/stage",
    "3 数值区间：value_min <= value <= value_max，且均为数值",
    "4 类型-谓词组合合法：predicate_type_combos",
    "5 source_ids 外键存在：均在 sources.csv 的 id 中",
    "6 B/G/H 双来源或 note 声明单来源",
    "7 阳光玫瑰行数 >= 20",
    "8 locator 非空率 100%",
    "9 entities 引用对应：triples 的 subject/object 名称可在 entities 中按 name 找到且类型一致"
  ],
  "graph": {
    "constraints": [
      "variety_id_unique: (n:Variety) REQUIRE n.id IS UNIQUE",
      "condition_id_unique: (n:Condition) REQUIRE n.id IS UNIQUE",
      "quality_indicator_id_unique: (n:QualityIndicator) REQUIRE n.id IS UNIQUE",
      "disease_id_unique: (n:Disease) REQUIRE n.id IS UNIQUE",
      "source_id_unique: (n:Source) REQUIRE n.id IS UNIQUE"
    ],
    "indexes": [
      "各标签 name 索引（便于按中文名直查）",
      "condition_category 索引（按温度/湿度/气调等分类查）"
    ],
    "rel_props": [
      "source_ids",
      "locator",
      "quote",
      "status",
      "confidence",
      "value",
      "value_min",
      "value_max",
      "unit",
      "stage",
      "effect",
      "level",
      "severity",
      "efficacy",
      "reason"
    ],
    "merge_keys": {
      "nodes": [
        "id"
      ],
      "rels": [
        "sid"
      ]
    }
  },
  "id_conventions": {
    "variety": "英文蛇形（shine_muscat / red_globe）",
    "condition": "英文蛇形（cold_0 / rh_90_95 / ca_o2）",
    "quality_indicator": "英文蛇形（decay_rate / shelf_life）",
    "disease": "英文蛇形（gray_mold / sour_rot）",
    "source": "英文蛇形（gbt16862_2026 / review_shine_muscat）",
    "triple_sid": "英文蛇形，建议 <subject简写>_<谓词简写>_<object简写>，全库唯一"
  }
}
