# 复制为 .env 后填写。不填 DEEPSEEK_API_KEY 时系统自动进入「离线模板模式」，
# 仍会返回带 [E#] 引用与分步动作的答案（演示保底路径）。

# ---- 大模型（DeepSeek，OpenAI 兼容接口） ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 图谱后端：local | neo4j ----
GRAPH_BACKEND=local
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- 界面 ----
UI_PORT=8501
UI_LARGE_FONT=false
UI_TOPK=6
