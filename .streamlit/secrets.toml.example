# 云端部署用 Secrets 模板（Streamlit Cloud / 魔搭创空间）
# 本地开发请用根目录 .env；本文件不要改名成 secrets.toml 提交仓库。
#
# Streamlit Cloud 配置路径：App → Settings → Secrets，粘贴下面内容：

DEEPSEEK_API_KEY = "sk-你的key"
DEEPSEEK_MODEL = "deepseek-chat"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"

GRAPH_BACKEND = "local"

# 可选
# UI_TOPK = "6"
# UI_LARGE_FONT = "false"
# UI_SHOW_CYPHER = "false"
# LLM_TIMEOUT = "20"
